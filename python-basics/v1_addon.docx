from abc import ABC, abstractmethod

# ============ Abstract Base Class ============
class HospitalSystem(ABC):
    @abstractmethod
    def execute():  # ERROR somewhere here
        pass

# ============ Person Class (Parent) ============
class Person:
    hospital_name = "City Care Hospital"  # Class Variable

    def _init_(self, name, age, contact):  # ERROR somewhere here
        self.name = name
        self._contact = contact        # Protected
        self__(age) = age              # ERROR somewhere here

    def get_age(self):
        return self.__age

    def show(self):
        print(f"Name: {self.name}, Contact: {self._contact}")

# ============ Doctor Class ============
class Doctor(Person):
    def __init__(self, name, age, contact, specialization):
        super().__init__(name, age, contact)
        self.specialization = specialization
        self.patients_treated = []     # List
        self.available_days = set()    # Set
        self.cabin = (2, 5)            # Tuple (floor, room)

    def add_patient(self, patient_name):
        self.patients_treated.append(patient_name)

    def set_availability(self, day):
        self.available_days.add(day)

    def show(self, detail=False):  # Polymorphism
        if detail:
            print(self__(dict))  # ERROR somewhere here
        else:
            print(f"Dr. {self.name} - {self.specialization}")

    def execute(self):
        print(f"Dr. {self.name} is on duty.")

# ============ Patient Class ============
class Patient(Person):
    def __init__(self, name, age, contact, disease):
        super__().__init__(name, age, contact)  # ERROR somewhere here
        self.disease = disease
        self.__bills = []              # Private

    def add_bill(self, amount):
        self__(bills).append(amount)  # ERROR somewhere here

    def get_total_bill(self):
        total = 0
        for bill in self.__bills:
            total += bill
        return total

    def show(self, detail=False):
        if detail:
            print(f"Patient: {self.name}, Disease: {self.disease}, Bills: {self.__bills}")
        else:
            print(f"Patient: {self.name} - {self.disease}")

    def execute(self):
        print(f"Patient {self.name} checked in.")

# ============ Hospital Class ============
class Hospital(HospitalSystem):
    def __init__(self):
        self.__doctors = []
        self.__patients = []

    def add_doctor(self, doctor):
        self.__doctors.append(doctor)

    def add_patient(self, patient):
        self.__patients.append(patient)

    def show_doctors(self):
        for doc in self.__doctors:
            doc.show()

    def show_patients(self):
        for pat in self.__patients:
            pat.show()

    def find_doctor(self, name):
        for doc in self.__doctors:
            if doc.name == name:
                return doc
        return None

    def execute(self):
        print("Hospital system running...")


# ============ Main Execution ============
h = Hospital()

d1 = Doctor("Sharma", 45, "9876543210", "Cardiology")
d1.set_availability("Monday")
d1.set_availability("Thursday")
d1.add_patient("Rahul")

d2 = Doctor("Verma", 38, "8765432109", "Neurology")

p1 = Patient("Rahul", 30, "7654321098", "Heart Block")
p1.add_bill(15000)
p1.add_bill(8000)

p2 = Patient("Priya", 25, "6543210987", "Migraine")

h.add_doctor(d1)
h.add_doctor(d2)
h.add_patient(p1)
h.add_patient(p2)

h.show_doctors()
h.show_patients()
print(f"Rahul's total bill: {p1.get_total_bill()}")
print(f"Dr. Sharma's age: {d1.get_age()}")
print(d1.__specialization)  # ERROR somewhere here
d1.execute()
p1.execute()
h.execute()